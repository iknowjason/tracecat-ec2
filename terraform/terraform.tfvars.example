# Copy to terraform.tfvars and fill in.
#
#   curl -s https://checkip.amazonaws.com     → your public address

# Nothing in this file is required — every variable has a working default.
# Copy it and change what you care about.

# The first Tracecat user — the account with full privileges.
#
# You claim it by signing up with this EXACT address the first time you open the
# UI, choosing a password there. Nothing is emailed; the stack has no SMTP, so
# this is an identity rather than a mailbox that must receive. Sign in with any
# other address and you get an ordinary unprivileged account.
#
# Decide before the first apply: it is written into /opt/tracecat/.env at boot
# and cloud-init only runs once, so changing it later replaces the instance and
# takes the database with it. Defaults to admin@example.com.
#
# The same address is what MCP authorises against, and what acme_email falls
# back to.
# superadmin_email = "you@example.com"

# Who may reach the UI. Leave this out entirely and Terraform looks up the
# public IP of the machine running it and allows just that /32.
#
# Set it explicitly for a corporate range, several offices, or when Terraform
# runs somewhere your browser does not (CI, a bastion, a different VPN).
# This deployment serves plain HTTP, so 0.0.0.0/0 is rejected by a validation
# rather than merely discouraged.
# allowed_cidrs = ["203.0.113.42/32"]

# Turn the lookup off if you would rather always be explicit.
# auto_detect_my_ip = false

aws_region    = "us-east-1"
instance_type = "t3.xlarge"

# Optional: use an existing VPC and public subnet instead of the default VPC.
# vpc_id    = "vpc-0123456789abcdef0"
# subnet_id = "subnet-0123456789abcdef0"

# Optional: SSH in addition to SSM Session Manager.
# enable_ssh = true
# key_name   = "my-keypair"

# ── Serving on a domain, which /mcp requires ────────────────────────────────
#
# app_hostname is the FULLY QUALIFIED subdomain to serve on. hosted_zone_id is
# the Route 53 zone that owns the domain ABOVE it — for tracecat.example.com
# that is the zone for example.com. Set both and Terraform writes the A record
# in the same apply, before Caddy's first ACME attempt.
#
# Find the zone id:
#   aws route53 list-hosted-zones \
#     --query "HostedZones[?Name=='example.com.'].{name:Name,id:Id,private:Config.PrivateZone}" \
#     --output table
#
# It comes back as /hostedzone/Z1234567890ABC. Use the BARE Z... part. The zone
# must be public, and the domain's nameservers must actually point at Route 53,
# or Let's Encrypt cannot resolve the name.
#
# Your credentials need route53:GetHostedZone, ListResourceRecordSets,
# ChangeResourceRecordSets and GetChange on that zone — see docs/deploy.md.
#
# Leave these out and Tracecat serves on the raw IP over plain HTTP; everything
# works except /mcp.
#
# app_hostname   = "tracecat.example.com"
# hosted_zone_id = "Z1234567890ABC"
# acme_email     = "you@example.com"    # Let's Encrypt contact; defaults to superadmin_email

# The MCP endpoint is on by default and needs no identity provider.
#
# From Tracecat 1.0.0-beta.51 the MCP server authenticates against an OIDC
# issuer Tracecat runs itself, with a client secret derived from a value env.sh
# already generates. Sign in as your Tracecat user in the browser flow, or mint
# a personal access token in the UI. Nothing to register anywhere.
#
# MCP REQUIRES TLS: the server refuses an issuer URL that is not https, so
# app_hostname and hosted_zone_id are not optional if you want /mcp. Port 80
# then opens to the internet for the ACME challenge; 443 stays restricted to
# allowed_cidrs.
#
# enable_mcp = false    # deploy over plain HTTP and accept that /mcp will not work

# Version pinning. tracecat_version selects the upstream tag the compose files
# come from AND, unless you override it, the container images.
#
# CAREFUL: upstream's tags do not sort by date. "1.0.0" was cut 2026-04-03, four
# months BEFORE 1.0.0-beta.51, and it needs an external OIDC provider that this
# module no longer deploys. Check a tag's commit date before pinning it.
#
# tracecat_version   = "1.0.0-beta.51"
# tracecat_image_tag = "1.0.0-beta.52-rc.23"   # only to split images from files
