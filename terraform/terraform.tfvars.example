# Copy to terraform.tfvars and fill in.
#
#   curl -s https://checkip.amazonaws.com     → your public address

# Nothing in this file is required — every variable has a working default.
# Copy it and change what you care about.

# The first Tracecat user. You sign up with this exact address on first visit.
# Defaults to admin@example.com if you leave it out.
# superadmin_email = "you@example.com"

# Who may reach the UI. Leave this out entirely and Terraform looks up the
# public IP of the machine running it and allows just that /32.
#
# Set it explicitly for a corporate range, several offices, or when Terraform
# runs somewhere your browser does not (CI, a bastion, a different VPN).
# This deployment serves plain HTTP, so 0.0.0.0/0 is rejected by a validation
# rather than merely discouraged.
# allowed_cidrs = ["203.0.113.42/32"]

# Turn the lookup off if you would rather always be explicit.
# auto_detect_my_ip = false

aws_region    = "us-east-1"
instance_type = "t3.xlarge"

# Optional: use an existing VPC and public subnet instead of the default VPC.
# vpc_id    = "vpc-0123456789abcdef0"
# subnet_id = "subnet-0123456789abcdef0"

# Optional: SSH in addition to SSM Session Manager.
# enable_ssh = true
# key_name   = "my-keypair"

# Optional: serve on a hostname instead of the raw IP. Point DNS at the
# Elastic IP first — Tracecat bakes this into PUBLIC_APP_URL at first boot.
# app_hostname = "tracecat.example.com"

# The MCP endpoint at http://<ip>/mcp is on by default.
#
# Tracecat's MCP container is an OIDC proxy and will not start without an
# identity provider, so a Dex container is deployed alongside the stack with a
# generated secret and one seeded login. Read the credentials afterwards with
#   sudo grep ^mcp_ /etc/tracecat/READY
#
# enable_mcp   = false                        # deploy without the MCP server
# mcp_idp_port = 5556                         # Dex's port, opened to allowed_cidrs
# mcp_idp_image = "ghcr.io/dexidp/dex:v2.45.1"
#
# To use your own identity provider instead, set all three of these and Dex is
# not deployed at all. The provider must allow http://<ip>/auth/callback as a
# redirect URI — which for a hosted IdP means giving this instance a DNS name
# and TLS first, since Cognito, Okta and Auth0 all require https callbacks.
#
# SECURITY: oidc_client_secret is written into the instance's user_data and into
# Terraform state. The built-in Dex secret is generated on the instance instead
# and never leaves it.
#
# oidc_issuer        = "https://example.okta.com/oauth2/default"
# oidc_client_id     = "0oa1b2c3d4e5f6g7h8i9"
# oidc_client_secret = "..."
# oidc_scopes        = "openid profile email"
